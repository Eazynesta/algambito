{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/crownline?_crownline_path=/" },
    { "source": "/:path(play|dashboard|profile|api|sign-in|sign-out|signin-with-chatgpt)", "destination": "/api/crownline?_crownline_path=/:path" }
  ]
}
